# repository root of your local filesystem
export DMT_ROOT=/path/to/your/dmt/repo

# put your own SLURM configs here
# this is intended to be the primary partition with compute nodes, 
# to use for both training and distributed inference for eval
export ACCOUNT=
export PARTITION=
export QOS=
export EMAIL=
export EXCLUDE_NODES="" # comma-separated list of nodes to exclude (e.g. known-faulty nodes)

# this intended for API calls to external services
# we need this to transparently call LLM-as-a-judge services across clusters
# this partition might only have cpus (as Leonardo's lrd_all_serial partition)
export INTERNET_PARTITION=
export INTERNET_PARTITION_TIME=
export INTERNET_PARTITION_CPUS=
export INTERNET_PARTITION_MEMORY=

# Some slurm clusters allow for a `debugging` partition,
# which typically grants higher priority access for a short amount of time.
# This may be implemented in various ways. For example, on Leonardo one only needs
# to set the --qos flag differently, but other clusters may use a different partition as well.
# The variables down below will be used when submitting scripts with DEBUG=1, so you should
# configure them such that you get high priority access with these. 
export DEBUG_ACCOUNT=
export DEBUG_PARTITION=
export DEBUG_QOS=
export DEBUG_TIME=

# where you want the SLURM logs for this project to be =)
export SLURM_LOGS_DIR=

# put the hardware specs of your cluster here
# for example, leonardo has 32 cpu cores and 4 gpus per node
export CPUS_PER_NODE=32
export GPUS_PER_NODE=4
export MEMORY=128G

# checkpointing root directory for this project
export CKPT_DIR=

# directory for evaluation files (csv or json from vlmevalkit)
export EVAL_DIR=

# setup model loading (for machines without internet access)
# this is supposed to be the folder where you put your huggingface-cli outputs
# do NOT put a trailing `/`
export OFFLINE_MODEL_DIR=

# directory for meta-files used for training
export META_DIR=/path/to/your/meta-json/files

# root folder of the downloaded datasets / candidate pools
export DATA_ROOT=/path/to/your/data

# setup W&B
# NOTE: on Leonardo, WANDB_MODE has to be 'offline'
export WANDB_DIR=
export WANDB_RUN_DIR=
export WANDB_CACHE_DIR=
export WANDB_ARTIFACT_DIR=
export WANDB_MODE="offline"
export WANDB_TEAM=

# shared directory for OpenCompass datasets
export COMPASS_DATA_CACHE=/path/to/shared/OpenCompass/datasets

# unzipped OpenCompassData `data/` folder, used to build the text decontamination index
# (data/filters/build_text_test_index.py)
export TEXT_EVAL_DATA_ROOT=/path/to/OpenCompassData/data

### What follows below is the .env you would use for VLMEvalKit ###
export LMUData=
