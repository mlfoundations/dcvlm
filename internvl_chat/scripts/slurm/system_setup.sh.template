# This file is supposed to load the software stack needed for training / evaluation.
# It will be sourced, hence you don't need a shebang and being executable is not a requirement.
# The only requirement is to ensure all lines in here bash-compatible instructions.

# There are 3 things you should do in here:
# 1. load / source your python virtual environment;
# 2. make sure the CUDA Compiler is there, and export all variables that may be needed;
# 3. (optionally) load / source a gcc version > 12 if that is not your default already;

### 1. load / source your python virtual environment 
# (venv template)
# source <whatever_your_env>/bin/activate 

# (conda template)
# eval "$(conda shell.bash hook)"
# conda activate yourenv

### This is how the rest of the script would look like on Leonardo ###
# 2. make sure the CUDA Compiler is there, and export all variables that may be needed;
# module load cuda/12.1
# 3. (optionally) load / source a gcc version > 12;
# module load gcc/12.2.0

### While this is how the rest of the script would look like on Galvani ###
# 2. make sure the CUDA Compiler is there, and export all variables that may be needed;
# export CUDA_VER=12.1
# export PATH=/usr/local/cuda-$CUDA_VER/bin:$PATH
# export LD_LIBRARY_PATH=/usr/local/cuda-$CUDA_VER/lib64:/usr/local/cuda-$CUDA_VER/extras/CUPTI/lib64:$LD_LIBRARY_PATH
# 3. (optionally) load / source a gcc version > 12;
# source scl_source enable gcc-toolset-10